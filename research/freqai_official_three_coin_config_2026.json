{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": 1000,
  "tradable_balance_ratio": 1,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 10000,
  "fee": 0.0005,
  "timeframe": "5m",
  "cancel_open_orders_on_exit": true,
  "unfilledtimeout": {
    "entry": 10,
    "exit": 30
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true
    },
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "SOL/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "price_last_balance": 0,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "freqai": {
    "enabled": true,
    "purge_old_models": 0,
    "train_period_days": 90,
    "backtest_period_days": 30,
    "save_backtest_models": true,
    "identifier": "v7-3coin-freqai-official-20261020-90d30d",
    "feature_parameters": {
      "include_timeframes": [
        "5m"
      ],
      "include_corr_pairlist": [],
      "label_period_candles": 12,
      "include_shifted_candles": 1,
      "DI_threshold": 0,
      "weight_factor": 0,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": false,
      "indicator_periods_candles": [
        10,
        20
      ],
      "plot_feature_importances": 0
    },
    "data_split_parameters": {
      "test_size": 0.2,
      "shuffle": false,
      "random_state": 72026
    },
    "model_training_parameters": {
      "n_estimators": 120,
      "learning_rate": 0.04,
      "max_depth": 5,
      "num_leaves": 15,
      "min_child_samples": 20,
      "reg_lambda": 2,
      "n_jobs": 1,
      "verbosity": -1,
      "random_state": 72026
    }
  }
}

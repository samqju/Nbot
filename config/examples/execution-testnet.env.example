# Trading VPS only. Copy to config/secrets/execution-testnet.env.
# Instructions: docs/ENVIRONMENT_SETUP.md
# Keep config/secrets mode 700 and this private copy mode 600.
# Replace BOTH required values with Futures USD-M TESTNET/demo credentials.
# Never use real-money API keys, SSH keys, or the control-link token here.
TESTNET_API_KEY=
TESTNET_API_SECRET=

# Optional Testnet limits: these are defaults, not recommended increases.
# Entry count persists across restarts; a deliberate arm starts a new session.
# Notional means position value, not the amount you are prepared to lose.
TESTNET_MAX_SESSION_ENTRIES=100
TESTNET_MAX_ENTRY_NOTIONAL_USD=1000

# Optional timeouts/cadence. Leave these unchanged for the first trial.
TESTNET_REST_TIMEOUT_SECONDS=5
NBOT_EXECUTION_IDLE_POLL_SECONDS=2
NBOT_EXECUTION_OPEN_POLL_SECONDS=0.5

# Optional Execution Telegram operator bot. Leave all three blank to omit it.
# BOT_TOKEN: your Telegram bot token; CHAT_ID: your numeric chat identifier;
# OPERATOR_USER_ID: your numeric Telegram user ID (not a username or phone).
EXECUTION_TELEGRAM_BOT_TOKEN=
EXECUTION_TELEGRAM_CHAT_ID=
EXECUTION_TELEGRAM_OPERATOR_USER_ID=
NBOT_TELEGRAM_TIMEOUT_SECONDS=5

# V3.8 Execution LIVE_PAPER local operator settings.
# Install as: config/secrets/execution-live-paper.env
# chmod 0600 config/secrets/execution-live-paper.env
#
# LIVE_PAPER never contains Binance private order credentials. The Execution
# worker uses Binance LIVE public market data + local PaperExchange only.

# Optional Execution Telegram bot. Use a different bot from Observation if the
# Observation command listener is enabled so only one process consumes each
# bot's getUpdates stream.
EXECUTION_TELEGRAM_BOT_TOKEN=
EXECUTION_TELEGRAM_CHAT_ID=
EXECUTION_TELEGRAM_OPERATOR_USER_ID=

# Optional HTTP timeout for Telegram Bot API calls.
NBOT_TELEGRAM_TIMEOUT_SECONDS=5

# Runtime cadence; defaults preserve V3.8 behavior when omitted.
NBOT_EXECUTION_IDLE_POLL_SECONDS=2
NBOT_EXECUTION_OPEN_POLL_SECONDS=0.5
LIVE_PUBLIC_REST_TIMEOUT_SECONDS=3
LIVE_PUBLIC_MAX_CLOCK_SKEW_MS=5000

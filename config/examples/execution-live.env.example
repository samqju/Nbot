# Trading VPS ONLY. Copy to config/secrets/execution-live.env, mode 600.
# Step-by-step instructions: docs/TRADING_MODES.md
# Required: a matching MAINNET USD-M Futures API key and secret.
# Do not put these on the Learning VPS or in a tracked file.
LIVE_API_KEY=
LIVE_API_SECRET=

# Small manual trial defaults. These are not guaranteed loss limits.
LIVE_RISK_PER_TRADE_USD=0.25
LIVE_MAX_ENTRY_NOTIONAL_USD=25
LIVE_LEVERAGE=1
LIVE_MAX_SESSION_ENTRIES=1
LIVE_REST_TIMEOUT_SECONDS=5
LIVE_RECV_WINDOW_MS=5000
NBOT_EXECUTION_IDLE_POLL_SECONDS=2
NBOT_EXECUTION_OPEN_POLL_SECONDS=0.5

# Optional Telegram; terminal controls work without it.
EXECUTION_TELEGRAM_BOT_TOKEN=
EXECUTION_TELEGRAM_CHAT_ID=
# Optional private command/reply chat. Open the bot privately and press Start.
EXECUTION_TELEGRAM_COMMAND_CHAT_ID=
EXECUTION_TELEGRAM_OPERATOR_USER_ID=
NBOT_TELEGRAM_TIMEOUT_SECONDS=5

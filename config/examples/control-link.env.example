# Both VPSs: private copy goes in config/secrets/control-link.env (mode 600).
# Instructions and secure token generation: docs/ENVIRONMENT_SETUP.md
# Required: generate ONE strong random token and copy the same value to both VPSs.
# Leave no blank value in the private file; do not use a human-chosen password.
NBOT_CONTROL_AUTH_TOKEN=

# Execution connects through the installed loopback SSH tunnel.
# Keep 127.0.0.1 here; the remote learning VPS IP goes in the SSH tunnel instead.
NBOT_OBSERVATION_TESTNET_URL=http://127.0.0.1:18766
NBOT_OBSERVATION_TIMEOUT_SECONDS=2.0

# Only for separately configured LIVE/PAPER control and its matching tunnel:
NBOT_OBSERVATION_LIVE_PAPER_URL=http://127.0.0.1:18765

# Advanced direct HTTPS transport only; leave absent for the beginner SSH setup.
# NBOT_OBSERVATION_CA_FILE=config/secrets/observation-control-ca.pem

# Only with the separately installed explicit mainnet trial tunnel:
NBOT_OBSERVATION_LIVE_TRADE_URL=http://127.0.0.1:18767

# Learning VPS only: separate simulated shadow accounts in learned LIVE modes.
# These NEVER change Trading risk or permit real orders. See docs/SHADOW_TRADING.md.
# Choose values before first start; settings are frozen per release/mode.
NBOT_SHADOW_ENABLED=1
NBOT_SHADOW_STARTING_BALANCE_USD=10000
NBOT_SHADOW_RISK_USD=10
NBOT_SHADOW_NOTIONAL_USD=1000
NBOT_SHADOW_SLIPPAGE_PCT=0.02
NBOT_SHADOW_TAKER_FEE_RATE=0.0005
NBOT_SHADOW_MAX_SPREAD_PCT=0.25
NBOT_SHADOW_MAX_REFERENCE_DRIFT_PCT=0.25
NBOT_SHADOW_DAILY_TRIGGER_R=100
NBOT_SHADOW_NORMAL_GIVEBACK_R=95
NBOT_SHADOW_PROFIT_GIVEBACK_R=3

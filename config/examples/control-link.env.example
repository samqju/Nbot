# NBOT V3.6 control link. Copy to config/secrets/control-link.env and chmod 600.
# The token must be identical on Observation and Execution.
NBOT_CONTROL_AUTH_TOKEN=replace-with-a-strong-random-token

# Execution-side profile target. For the SSH-loopback transport used in V3.6:
NBOT_OBSERVATION_TESTNET_URL=http://127.0.0.1:18766
NBOT_OBSERVATION_TIMEOUT_SECONDS=2.0

# Optional for direct HTTPS transport instead of an SSH/private tunnel:
# NBOT_OBSERVATION_CA_FILE=config/secrets/observation-control-ca.pem

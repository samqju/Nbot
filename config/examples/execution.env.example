# V3 Execution secrets are created deliberately per phase/profile.
# Do not copy V1/V2 .env files into V3.
#
# V3.2 Testnet runtime file:
#   config/secrets/execution-testnet.env
# chmod 0600 that file; config/secrets/ remains chmod 0700.
#
# Required only when V3.2 is deliberately started:
# TESTNET_API_KEY=
# TESTNET_API_SECRET=
#
# Testnet endpoints are hard-pinned by code. Do not redirect this profile to LIVE.
# Optional operational tuning retains the V3.1 safety defaults when omitted.
# TESTNET_REST_TIMEOUT_SECONDS=5
# NBOT_EXECUTION_IDLE_POLL_SECONDS=2
# NBOT_EXECUTION_OPEN_POLL_SECONDS=0.5

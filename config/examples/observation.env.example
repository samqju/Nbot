# Observation uses public market access and must not contain Binance order secrets.
# Install optional operator settings as:
#   config/secrets/observation-live.env
# chmod 0600 config/secrets/observation-live.env
#
# Use a separate Telegram bot from Execution when Observation commands are
# enabled. Observation Telegram is read-only and has no order authority.
OBSERVATION_TELEGRAM_BOT_TOKEN=
OBSERVATION_TELEGRAM_CHAT_ID=
OBSERVATION_TELEGRAM_OPERATOR_USER_ID=
NBOT_TELEGRAM_TIMEOUT_SECONDS=5

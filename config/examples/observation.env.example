# Observation uses public market access and must not contain Binance order secrets.
# Install optional OUTBOUND notification settings as:
#   config/secrets/observation-live.env
# chmod 0600 config/secrets/observation-live.env
#
# Observation does NOT own a Telegram command listener. The single operator
# command bot runs on Execution and exposes Observation/research status through
# the authenticated read-only control-link proxy. These optional credentials are
# used only for best-effort outbound collector/research notifications.
OBSERVATION_TELEGRAM_BOT_TOKEN=
OBSERVATION_TELEGRAM_CHAT_ID=
NBOT_TELEGRAM_TIMEOUT_SECONDS=5

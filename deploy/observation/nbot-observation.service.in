[Unit]
Description=NBOT Observation Worker
Wants=network-online.target
After=network-online.target
PartOf=nbot-observer.target

[Service]
Type=simple
User=@NBOT_USER@
WorkingDirectory=@NBOT_REPO@
ExecStart=@NBOT_PYTHON@ run_observation.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

[Unit]
Description=NBOT Automatic Training Supervisor
Wants=network-online.target
After=network-online.target
PartOf=nbot-observer.target

[Service]
Type=simple
User=@NBOT_USER@
WorkingDirectory=@NBOT_REPO@
ExecStart=@NBOT_PYTHON@ -m scripts.learning.auto_train --watch
Restart=on-failure
RestartSec=5
# Phase 6B.6: training must remain subordinate to realtime observation.
Nice=10
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
CPUQuota=75%
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1

[Install]
WantedBy=multi-user.target

# NBOT V2 Observation VPS optional operations settings.
# No Binance order-writing credentials belong on this VPS.

# Separate rotating Observation log.
NBOT_OBSERVATION_LOG_PATH=logs/observation.log
BOT_LOG_LEVEL=INFO
NBOT_LOG_MAX_BYTES=5242880
NBOT_LOG_BACKUP_COUNT=3

# Optional read-only Observation Telegram.
# Use a SEPARATE bot from Execution when long polling is enabled. Observation
# intentionally does not fall back to shared TELEGRAM_* credentials.
OBSERVATION_TELEGRAM_BOT_TOKEN=
OBSERVATION_TELEGRAM_CHAT_ID=
OBSERVATION_TELEGRAM_OPERATOR_USER_ID=

# NBOT V2.8 Execution VPS only.
# Install as: /home/ubuntu/.config/nbot/.env
# chmod 600 /home/ubuntu/.config/nbot/.env
# NEVER commit the real API key or secret.

NBOT_EXECUTION_ENV=TESTNET

TESTNET_API_KEY=
TESTNET_API_SECRET=
TESTNET_BASE_URL=https://demo-fapi.binance.com
TESTNET_WS_BASE_URL=wss://demo-fstream.binance.com/ws
TESTNET_USER_STREAM_READY_TIMEOUT=20
TESTNET_REST_TIMEOUT_SECONDS=5
TESTNET_RECV_WINDOW_MS=5000

# Explicit Testnet write gate inherited from the proven V1 mechanics.
TESTNET_TRADING_CONFIRMATION=I_ACCEPT_TESTNET_ORDER_EXECUTION
TESTNET_TRADING_ARM_FILE=/var/lib/nbot-execution/TESTNET_TRADING_ARMED
TESTNET_MAX_SESSION_ENTRIES=100
TESTNET_MAX_ENTRY_NOTIONAL_USD=1000

# Frozen mechanical-canary limits; these are not strategy optimization.
TESTNET_RISK_PER_TRADE_USD=10
TESTNET_LEVERAGE=5
TESTNET_MAX_SPREAD_PCT=0.25
TESTNET_MAX_REFERENCE_PRICE_DRIFT_PCT=0.25

# Execution-owned mutable state. Never shared with Observation.
TESTNET_EXECUTION_STATE_PATH=/var/lib/nbot-execution/execution_v2_state.json
TESTNET_CANARY_OUTCOMES_PATH=/var/lib/nbot-execution/testnet_canary_outcomes.jsonl

# NBOT V2.8 Execution VPS only.
# Install as: /home/ubuntu/.config/nbot/.env
# chmod 600 /home/ubuntu/.config/nbot/.env
# NEVER commit the real API key or secret.

NBOT_EXECUTION_ENV=TESTNET

TESTNET_API_KEY=
TESTNET_API_SECRET=
TESTNET_BASE_URL=https://demo-fapi.binance.com
TESTNET_WS_BASE_URL=wss://demo-fstream.binance.com/ws
TESTNET_USER_STREAM_READY_TIMEOUT=20
TESTNET_REST_TIMEOUT_SECONDS=5
TESTNET_RECV_WINDOW_MS=5000

# Explicit Testnet write gate inherited from the proven V1 mechanics.
TESTNET_TRADING_CONFIRMATION=I_ACCEPT_TESTNET_ORDER_EXECUTION
TESTNET_TRADING_ARM_FILE=/var/lib/nbot-execution/TESTNET_TRADING_ARMED
TESTNET_MAX_SESSION_ENTRIES=100
TESTNET_MAX_ENTRY_NOTIONAL_USD=1000

# Frozen mechanical-canary limits; these are not strategy optimization.
TESTNET_RISK_PER_TRADE_USD=10
TESTNET_LEVERAGE=5
TESTNET_MAX_SPREAD_PCT=0.25
TESTNET_MAX_REFERENCE_PRICE_DRIFT_PCT=0.25

# Execution-owned mutable state. Never shared with Observation.
TESTNET_EXECUTION_STATE_PATH=/var/lib/nbot-execution/execution_v2_state.json
TESTNET_CANARY_OUTCOMES_PATH=/var/lib/nbot-execution/testnet_canary_outcomes.jsonl

# V2.8.5 V1-parity execution safeguards. These preserve frozen V1 behavior;
# changing them is a deliberate risk-policy decision, not deployment tuning.
NBOT_EXECUTION_NOTIONAL_TOLERANCE_PCT=1.0
NBOT_EXECUTION_RISK_TOLERANCE_PCT=10.0
NBOT_EXECUTION_MAX_ENTRY_SLIPPAGE_PCT=1.0
NBOT_EXECUTION_DAILY_PROFIT_LOCK_TRIGGER_R=100.0
NBOT_EXECUTION_DAILY_NORMAL_GIVEBACK_R=95.0
NBOT_EXECUTION_DAILY_PROFIT_GIVEBACK_R=3.0
NBOT_EXECUTION_EMERGENCY_FLATTEN_ATTEMPTS=2
NBOT_EXECUTION_EMERGENCY_VERIFY_DELAY_SECONDS=0.5
STOP_TRIGGER_GRACE_SECONDS=8
STOP_TRIGGER_POLL_INTERVAL_SECONDS=0.5

# Separate rotating execution logs. Defaults are shown explicitly.
NBOT_EXECUTION_LOG_PATH=/var/lib/nbot-execution/logs/execution.log
NBOT_EXECUTION_TRADE_LOG_PATH=/var/lib/nbot-execution/logs/execution-trades.log
BOT_LOG_LEVEL=INFO
NBOT_LOG_MAX_BYTES=5242880
NBOT_LOG_BACKUP_COUNT=3

# Optional Execution Telegram. V1 TELEGRAM_* names are accepted as fallback on
# Execution only. Telegram can enable/disable NEW entries but cannot bypass
# Testnet arming, daily risk, proposal authority, exchange checks or emergency
# boundaries.
EXECUTION_TELEGRAM_BOT_TOKEN=
EXECUTION_TELEGRAM_CHAT_ID=
EXECUTION_TELEGRAM_OPERATOR_USER_ID=

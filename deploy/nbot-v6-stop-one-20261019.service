[Unit]
Description=NBOT V6 finite -1 percent vs -2 percent stop native A/B (NO TRADING)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/root/nbot-v6-m1-20261016/global-next-source/scripts/m2r_v6_stop_one_batch.py

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/root/nbot-v6-m1-20261016/global-next-source
Environment=PYTHONUNBUFFERED=1
Environment=NBOT_V6_STOP_ONE_OPTIN=OWNER_AUTHORIZED_OFFLINE_MINUS_ONE_STOP_AB_ONLY
ExecStart=/usr/bin/python3 /root/nbot-v6-m1-20261016/global-next-source/scripts/m2r_v6_stop_one_batch.py --execute
Restart=no
TimeoutStartSec=0
TimeoutStopSec=120
KillMode=control-group
UMask=0022
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

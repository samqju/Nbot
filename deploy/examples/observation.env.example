# NBOT Observation VPS environment
#
# Copy to .env and fill the shared control token locally. Never commit .env.
# One Observation .env supports LIVE or TESTNET public observation. Keep
# TRADING_ENV and EXECUTION_MODE identical to the Execution VPS so proposal and
# outcome protocol identities match. Observation never receives order secrets.

# ===== Active runtime identity =====
TRADING_ENV=LIVE
EXECUTION_MODE=SHADOW

# ===== Public Binance Futures market data only =====
TESTNET_BASE_URL=https://demo-fapi.binance.com
TESTNET_MARKET_WS_URL=wss://stream.binancefuture.com/ws/!ticker@arr
LIVE_BASE_URL=https://fapi.binance.com
LIVE_MARKET_WS_URL=wss://fstream.binance.com/market/ws/!ticker@arr

# ===== Execution <-> Observation control boundary =====
# Must be at least 32 characters and exactly match Execution.
OBSERVATION_CONTROL_TOKEN=CHANGE_ME

# ===== Observation strategy / learning authority =====
# STRUCTURE is the production base strategy. Learning, shadow scoring,
# champion/challenger evaluation and canary routing remain active around it.
STRATEGY_MODE=STRUCTURE
SHADOW_MODEL_SCORING_ENABLED=true
SHADOW_DECISION_TESTING_ENABLED=true
VIRTUAL_LAB_ENABLED=true
AUTO_TRAINING_ENABLED=true
AUTOMATIC_PROMOTION_ENABLED=true
PAPER_CANARY_EXECUTION_ENABLED=true
PAPER_CANARY_CONTROLLER_ENABLED=true
PAPER_CANARY_RISK_MULTIPLIER=1.0

# ===== Shared paper-cost assumptions used by Observation evaluation =====
PAPER_TAKER_FEE_RATE=0.0005
PAPER_ENTRY_SLIPPAGE_PCT=0.02
PAPER_EXIT_SLIPPAGE_PCT=0.02

# ===== Observation universe =====
OBSERVATION_UNIVERSE_SIZE=200
OBSERVATION_UNIVERSE_CORE_SIZE=150
OBSERVATION_UNIVERSE_MIN_QUOTE_VOLUME=3000000
OBSERVATION_UNIVERSE_MAX_SPREAD_PCT=0.50
OBSERVATION_UNIVERSE_REFRESH_SECONDS=1800
STRUCTURE_UNIVERSE_ENABLED=true
STRUCTURE_UNIVERSE_SIZE=30
STRUCTURE_UNIVERSE_PREFILTER_SIZE=80

# ===== Virtual observation capacity =====
VIRTUAL_TRADE_TARGET_R=2.0
VIRTUAL_TRADE_MAX_CANDLES=24
VIRTUAL_TRADE_MAX_ACTIVE=500

# ===== Observation logging =====
BOT_LOG_LEVEL=INFO

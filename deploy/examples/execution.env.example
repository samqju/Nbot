# NBOT Execution VPS environment
#
# Copy to .env and fill secret values locally. Never commit the real .env.
# One Execution .env supports LIVE/TESTNET and SHADOW/TRADE selection.
# Change TRADING_ENV / EXECUTION_MODE deliberately and satisfy the relevant
# safety gates before restart. LIVE real-money order writing remains disabled.

# ===== Active runtime identity =====
TRADING_ENV=LIVE
EXECUTION_MODE=SHADOW

# ===== Binance Futures Testnet: public + Execution-private surfaces =====
TESTNET_BASE_URL=https://demo-fapi.binance.com
TESTNET_MARKET_WS_URL=wss://stream.binancefuture.com/ws/!ticker@arr
TESTNET_USER_WS_URL=wss://stream.binancefuture.com/ws
TESTNET_USER_STREAM_READY_TIMEOUT=20
TESTNET_API_KEY=
TESTNET_API_SECRET=

# ===== Binance Futures Mainnet: public + future/read-only private surfaces =====
LIVE_BASE_URL=https://fapi.binance.com
LIVE_MARKET_WS_URL=wss://fstream.binance.com/market/ws/!ticker@arr
LIVE_USER_WS_URL=wss://fstream.binance.com/ws
LIVE_USER_STREAM_READY_TIMEOUT=20
LIVE_USER_STREAM_KEEPALIVE_SECONDS=1800
LIVE_USER_STREAM_RECONNECT_SECONDS=5
LIVE_USER_STREAM_RECV_TIMEOUT_SECONDS=60
LIVE_USER_STREAM_EVENT_QUEUE_MAX=1000
LIVE_API_KEY=
LIVE_API_SECRET=

# ===== Execution <-> Observation control boundary =====
# Must be at least 32 characters and exactly match Observation.
OBSERVATION_CONTROL_TOKEN=CHANGE_ME
EXECUTION_CONTROL_LOOP_INTERVAL_SECONDS=0.25
EXECUTION_PROPOSAL_MAX_FUTURE_SKEW_SECONDS=5
EXECUTION_OUTCOME_RETRY_INTERVAL_SECONDS=5

# ===== Execution operator controls =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OPERATOR_USER_ID=
BOT_LOG_LEVEL=INFO

# ===== SHADOW paper execution assumptions =====
PAPER_STARTING_BALANCE_USD=10000
PAPER_TAKER_FEE_RATE=0.0005
PAPER_ENTRY_SLIPPAGE_PCT=0.02
PAPER_EXIT_SLIPPAGE_PCT=0.02
PAPER_PREFLIGHT_SYMBOL=BTCUSDT
PAPER_PREFLIGHT_CANDLE_LIMIT=5

# ===== Position-feed fallback / stop settlement =====
PAPER_WS_FIRST_TICK_TIMEOUT_SECONDS=10
PAPER_REST_POLL_INTERVAL_SECONDS=2
PAPER_WS_RETRY_INTERVAL_SECONDS=300
STOP_TRIGGER_GRACE_SECONDS=8
STOP_TRIGGER_POLL_INTERVAL_SECONDS=0.5

# ===== Execution-owned environment-isolated state =====
TESTNET_PAPER_STATE_PATH=data/paper_state_testnet.json
TESTNET_PAPER_TRADES_PATH=data/paper_trades_testnet.jsonl
LIVE_PAPER_STATE_PATH=data/paper_state_live.json
LIVE_PAPER_TRADES_PATH=data/paper_trades_live.jsonl
TESTNET_BOT_STATE_PATH=data/bot_state_testnet.json
LIVE_BOT_STATE_PATH=data/bot_state_live.json
TESTNET_EXECUTION_OUTBOX_PATH=data/execution_outbox_testnet
LIVE_EXECUTION_OUTBOX_PATH=data/execution_outbox_live

# ===== TESTNET + TRADE safety gates =====
# Keep confirmation DISABLED during normal LIVE/SHADOW or TESTNET/SHADOW use.
# For an intentional TESTNET+TRADE session, set it to
# I_ACCEPT_TESTNET_ORDER_EXECUTION and create the separately required arm file.
TESTNET_TRADING_CONFIRMATION=DISABLED
TESTNET_TRADING_ARM_FILE=runtime/TESTNET_TRADING_ARMED
TESTNET_MAX_SESSION_ENTRIES=5
TESTNET_MAX_ENTRY_NOTIONAL_USD=1000
TESTNET_REQUIRE_FLAT_START=true

# ===== LIVE + TRADE remains fail-closed =====
# The current adapter is read-only and real-money order writes are not
# implemented. Do not change these controls until the roadmap explicitly
# reaches real-capital enablement.
LIVE_TRADING_CONFIRMATION=DISABLED
LIVE_ADAPTER_MODE=READ_ONLY
LIVE_ORDER_WRITES_ENABLED=false
LIVE_TRADING_ARM_FILE=data/live_trading.arm
LIVE_SNAPSHOT_PATH=data/live_snapshot.json

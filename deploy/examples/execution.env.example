# NBOT Execution VPS example
#
# Copy to .env and replace CHANGE_ME.
# Never commit the real .env file.

TRADING_ENV=LIVE
EXECUTION_MODE=SHADOW

LIVE_BASE_URL=https://fapi.binance.com
LIVE_MARKET_WS_URL=wss://fstream.binance.com/market/ws/!ticker@arr

# Must be at least 32 characters and must exactly match Observation.
# CHANGE_ME intentionally fails NBOT validation until you replace it.
OBSERVATION_CONTROL_TOKEN=CHANGE_ME

# Future private/order-writing Binance credentials belong only on Execution.
# They are not required for the currently proven LIVE + SHADOW deployment.

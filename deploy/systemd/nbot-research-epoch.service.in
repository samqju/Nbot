[Unit]
Description=NBOT V3.8 LIVE Research 96-Event Epoch
After=network-online.target nbot-observation-live.service
Wants=network-online.target nbot-observation-live.service

[Service]
Type=oneshot
User=@NBOT_USER@
WorkingDirectory=@NBOT_ROOT@
Environment=PYTHONUNBUFFERED=1
Environment=NBOT_PROFILE=live-paper
EnvironmentFile=-@NBOT_ROOT@/config/secrets/observation-live.env
ExecStart=@NBOT_PYTHON@ @NBOT_ROOT@/nbot_admin.py research-epoch-run --prune-raw
Nice=15
CPUWeight=20
IOWeight=20
IOSchedulingClass=idle
OOMScoreAdjust=500
TimeoutStartSec=4h30min
UMask=0077
NoNewPrivileges=true

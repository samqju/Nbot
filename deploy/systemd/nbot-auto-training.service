[Unit]
Description=NBOT Phase 5.8 Automatic Training Supervisor
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/nbot
ExecStart=%h/nbot/venv/bin/python -m scripts.learning.auto_train --watch
Restart=on-failure
RestartSec=10
Nice=10
CPUWeight=10
IOSchedulingClass=idle
UMask=0077

[Install]
WantedBy=default.target

[Unit]
Description=NBOT V4 frozen-model paper contest
After=network-online.target nbot-observation-live.service nbot-v4-research.service
Wants=network-online.target

[Service]
Type=simple
User=@NBOT_USER@
WorkingDirectory=@NBOT_ROOT@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=@NBOT_ROOT@
ExecStart=@NBOT_PYTHON@ @NBOT_ROOT@/deploy/observation/run_v4_paper_contest.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
MemoryHigh=192M
MemoryMax=320M
CPUQuota=40%
Nice=5

[Install]
WantedBy=multi-user.target

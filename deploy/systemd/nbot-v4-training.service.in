[Unit]
Description=NBOT V4 challenger training batch
After=network-online.target

[Service]
Type=oneshot
User=@NBOT_USER@
WorkingDirectory=@NBOT_ROOT@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=@NBOT_ROOT@
ExecStart=@NBOT_PYTHON@ @NBOT_ROOT@/deploy/observation/run_v4_training.py
Nice=10
CPUQuota=35%
MemoryHigh=256M
MemoryMax=384M
NoNewPrivileges=true

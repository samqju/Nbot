[Unit]
Description=NBOT V4 challenger training batch
After=network-online.target

[Service]
Type=oneshot
User=@NBOT_USER@
WorkingDirectory=@NBOT_ROOT@
Environment=PYTHONUNBUFFERED=1
ExecStart=@NBOT_PYTHON@ @NBOT_ROOT@/deploy/observation/run_v4_training.py
Nice=10
CPUQuota=50%
MemoryHigh=512M
MemoryMax=768M
NoNewPrivileges=true

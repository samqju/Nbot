[Unit]
Description=NBOT V3 Execution Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@NBOT_ROOT@
Environment=NBOT_PROFILE=@NBOT_PROFILE@
ExecStart=@NBOT_ROOT@/.venv/bin/python @NBOT_ROOT@/run_execution.py --profile @NBOT_PROFILE@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

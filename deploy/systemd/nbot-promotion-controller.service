[Unit]
Description=NBOT Phase 5.10 Automatic Promotion Controller
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/nbot
ExecStart=%h/venv/bin/python -m scripts.learning.promotion_controller --watch
Restart=on-failure
RestartSec=10
Nice=10
CPUWeight=10
IOSchedulingClass=idle
UMask=0077

[Install]
WantedBy=default.target

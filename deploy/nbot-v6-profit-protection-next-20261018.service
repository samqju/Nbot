After=docker.service
Wants=docker.service
ConditionPathExists=/root/nbot-v6-m1-20261016/library-20261018/v6-profit-protection-successor-wait-once.sh

[Service]
Type=simple
User=root
WorkingDirectory=/root/nbot-v6-m1-20261016
ExecStart=/bin/bash /root/nbot-v6-m1-20261016/library-20261018/v6-profit-protection-successor-wait-once.sh

[Unit]
Description=NBOT V5 G4 bounded public-only compressed source pilot (manual OWNER RELEASE)
Requisite=nbot-v5-g1g2g3-observation.service
After=nbot-v5-g1g2g3-observation.service
ConditionPathExists=/home/ubuntu/Nbot/runtime/source/OWNER_APPROVED_G4_CAPTURE_RELEASE

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Nbot
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/home/ubuntu/Nbot/.venv/bin/python -m nbot.v5.g4_source_preflight --g1-db /home/ubuntu/Nbot/runtime/observation/g1g2g3.sqlite --cohort-manifest /home/ubuntu/Nbot/runtime/source/g4-forward-cohort/cohort.json --source-root /home/ubuntu/Nbot/runtime/source/g4-forward-cohort
ExecStart=/usr/bin/flock -n /home/ubuntu/Nbot/runtime/source/g4-forward-cohort/owner.lock /home/ubuntu/Nbot/.venv/bin/python -u -m nbot.v5.g4_forward_capture_runner --cohort-manifest /home/ubuntu/Nbot/runtime/source/g4-forward-cohort/cohort.json --source-root /home/ubuntu/Nbot/runtime/source/g4-forward-cohort --storage-mode segments --max-seconds 21600 --max-frames 20000000 --max-db-mib 8192 --sustained-source --enable-network
Restart=no
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/Nbot/runtime/source/g4-forward-cohort
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=180M
CPUQuota=40%
Nice=10
TasksMax=24

# TEMPLATE ONLY. NO [Install] / autostart. Owner-release marker must not be
# created until G1 cohort is independently frozen and full pilot capacity
# reviewed. Six-hour bounded pilot is NOT final continuous science acceptance.
# Never installed or enabled by the engineering deployment.

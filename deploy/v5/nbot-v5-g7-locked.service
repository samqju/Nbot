[Unit]
Description=NBOT V5 G7 zero-orders locked health only (deployment HOLD)
After=network.target
ConditionPathExists=/home/ubuntu/Nbot/runtime/paper/OWNER_APPROVED_LOCKED_HEALTH

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Nbot
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/flock -n /home/ubuntu/Nbot/runtime/paper/owner.lock /home/ubuntu/Nbot/.venv/bin/python -u -m nbot.v5.paper_health_runner --root /home/ubuntu/Nbot/runtime/paper --policy /home/ubuntu/Nbot/runtime/paper/policy.json
Restart=no
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/Nbot/runtime/paper
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
MemoryMax=100M
CPUQuota=10%
Nice=15
TasksMax=16

# Intentionally no [Install] section; owner approval needed even for locked health.
# No real-money or exchange interface exists in paper_health_runner.

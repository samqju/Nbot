[Unit]
Description=NBOT Execution Worker
Wants=network-online.target nbot-observation-tunnel.service
After=network-online.target nbot-observation-tunnel.service

[Service]
Type=simple
User=@NBOT_USER@
WorkingDirectory=@NBOT_REPO@
ExecStart=@NBOT_PYTHON@ run_execution.py --yes
Restart=on-failure
RestartSec=5
# Deliver SIGINT so run_execution.py follows its existing clean
# KeyboardInterrupt/finally shutdown path.
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

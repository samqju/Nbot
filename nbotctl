ACTIVE_EXECUTION_PHASE = "V3.7"
PHASE_STATUS = "V3.7_OPERATIONALLY_PROVEN"
PHASE_GATE_STATUS = "PASSED"
NEXT_PHASE = "V3.8"
DEFERRED_ACCEPTANCE = ()


def _git_identity() -> dict[str, str]:
    def run(*args: str) -> str:
        try:
            return subprocess.check_output(args, cwd=ROOT, text=True, stderr=subprocess.DEVNULL).strip()
        except Exception:
            return "UNKNOWN"
    return {
        "sha": run("git", "rev-parse", "HEAD"),
        "tag": run("git", "describe", "--tags", "--exact-match", "HEAD"),
    }


def _merge_results(*results) -> tuple[bool, list[str], list[str]]:
    ok = True
    checks: list[str] = []
    warnings: list[str] = []
    for result in results:
        ok = ok and result.ok
        checks.extend(result.checks)
        warnings.extend(result.warnings)
    return ok, checks, warnings


def _secret_environment(profile_name: str) -> dict[str, str]:
    if profile_name == "testnet-trade":
        source = ROOT / "config/secrets/execution-testnet.env"
        return merged_environment(source, environ=os.environ)
    if profile_name == "live-paper":
        source = ROOT / "config/secrets/execution-live-paper.env"
        return merged_environment(source, environ=os.environ)
    if profile_name == "live-trade":
        source = ROOT / "config/secrets/execution-live.env"
        return merged_environment(source, environ=os.environ)
    return merged_environment(environ=os.environ)


def _doctor_payload(profile_name: str) -> tuple[dict, int]:
    role = detect_role(ROOT)
    profile = get_profile(profile_name)
    environment = _secret_environment(profile.name) if role.value == "EXECUTION" else dict(os.environ)
    role_profile = validate_role_profile(
        repo_root=ROOT, role=role, profile=profile, environment=environment
    )
    host = validate_host_foundation(repo_root=ROOT, role=role)
    results = [role_profile, host]
    if role.value == "EXECUTION":
        results.append(
            validate_execution_v31(
                repo_root=ROOT, profile=profile, environment=environment
            )
        )
    ok, checks, warnings = _merge_results(*results)
    payload = {
        "status": "PASS" if ok else "FAIL",
        "phase": PHASE,
        "active_execution_phase": ACTIVE_EXECUTION_PHASE if role.value == "EXECUTION" else PHASE,
        "phase_status": PHASE_STATUS,
        "phase_gate_status": PHASE_GATE_STATUS,
        "next_phase": NEXT_PHASE,
        "deferred_acceptance": list(DEFERRED_ACCEPTANCE),
        "role": role.value,
        "profile": profile.name,
        "market_environment": profile.market_environment,
        "execution_mode": profile.execution_mode,
        "evidence_lineage": profile.evidence_lineage,
        "arm_required": bool(role.value == "EXECUTION" and profile.requires_arm_gate),
        "arm_state": arm_state(ROOT, role, profile),
        "git": _git_identity(),
        "checks": checks,
        "warnings": warnings,
    }
    return payload, (0 if ok else 2)


def _runtime_leaf(profile_name: str) -> str:
    return {
        "testnet-trade": "testnet",
        "live-paper": "paper",
        "live-trade": "real",
    }[profile_name]


def _runtime_paths(profile_name: str) -> tuple[Path, Path, Path]:
    leaf = _runtime_leaf(profile_name)
    runtime = ROOT / "runtime" / "execution" / leaf
    log = execution_log_paths(ROOT, profile_name)["execution"]
    return runtime / "execution.pid", runtime / "execution.ready", log


def _read_kv_file(path: Path) -> dict[str, str]:
    if not path.is_file():
        return {}
    values: dict[str, str] = {}
    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        if "=" not in raw:
            continue
        key, value = raw.split("=", 1)
        values[key.strip()] = value.strip()
    return values


def _pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _pid_matches_execution_runtime(pid: int, profile_name: str) -> bool:
    """Never trust a stale/reused PID without matching the exact runtime command."""
    if not _pid_alive(pid):
        return False
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return False
    argv = [part.decode("utf-8", errors="replace") for part in raw.split(b"\0") if part]
    expected_script = str(ROOT / "run_execution.py")
    if expected_script not in argv:
        return False
    try:
        profile_index = argv.index("--profile")
    except ValueError:
        return False
    return profile_index + 1 < len(argv) and argv[profile_index + 1] == profile_name


def _runtime_record(profile_name: str, *, clean_stale: bool = False) -> dict | None:
    pid_path, ready_path, log_path = _runtime_paths(profile_name)
    values = _read_kv_file(pid_path)
    if not values:
        return None
    try:
        pid = int(values.get("pid", "0"))
    except ValueError:
        pid = 0
    alive = _pid_matches_execution_runtime(pid, profile_name)
    if not alive and clean_stale:
        pid_path.unlink(missing_ok=True)
        ready_path.unlink(missing_ok=True)
        return None
    return {
        "profile": profile_name,
        "pid": pid,
        "alive": alive,
        "ready": bool(alive and ready_path.is_file()),
        "pid_file": str(pid_path.relative_to(ROOT)),
        "log_file": str(log_path.relative_to(ROOT)),
        "release_sha": values.get("sha"),
        "started_at": values.get("started_at"),
    }


def _active_runtimes(*, clean_stale: bool = False) -> list[dict]:
    rows = []
    for name in PROFILES:
        row = _runtime_record(name, clean_stale=clean_stale)
        if row is not None and row["alive"]:
            rows.append(row)
    return rows


def _execution_state_summary(profile_name: str) -> dict:
    try:
        from nbot.execution.outcomes import PendingOutcomeOutbox
        from nbot.execution.state import ExecutionStatePaths, ExecutionStateStore

        profile = get_profile(profile_name)
        paths = ExecutionStatePaths.for_profile(ROOT, profile.name)
        pending = PendingOutcomeOutbox(paths.pending_outcomes_dir).pending_count()
        if not paths.state_file.is_file():
            return {"state": "ABSENT_CLEAN_START", "pending_outcomes": pending}
        store = ExecutionStateStore(
            paths.state_file,
            profile=profile.name,
            market_environment=profile.market_environment,
        )
        snap = store.snapshot
        open_detail = None
        if snap.open_position is not None:
            open_detail = {
                "symbol": snap.open_position.symbol,
                "side": snap.open_position.side,
                "quantity": snap.open_position.quantity,
                "entry_price": snap.open_position.entry_price,
                "stop_price": snap.open_position.stop_price,
                "mfe_r": snap.open_position.mfe_r,
                "mae_r": snap.open_position.mae_r,
            }
        telemetry_dir = ROOT / "data/execution/testnet/mechanical_canary_telemetry"
        telemetry_files = sorted(telemetry_dir.glob("*.jsonl"), key=lambda item: item.stat().st_mtime) if telemetry_dir.is_dir() else []
        return {
            "state": "VALID",
            "entries_enabled": snap.entries_enabled,
            "open_position": None if snap.open_position is None else snap.open_position.symbol,
            "open_position_detail": open_detail,
            "entry_inflight": None if snap.entry_inflight is None else snap.entry_inflight.proposal_id,
            "pending_outcomes": pending,
            "recovery_critical": snap.recovery.critical,
            "recovery": asdict(snap.recovery),
            "health": asdict(snap.health),
            "last_event": snap.health.last_event,
            "latest_testnet_mechanical_telemetry": (
                None if profile.name != "testnet-trade" or not telemetry_files
                else str(telemetry_files[-1].relative_to(ROOT))
            ),
        }
    except Exception as exc:
        return {"state": f"INVALID:{type(exc).__name__}:{exc}"}


def cmd_bootstrap(_: argparse.Namespace) -> int:
    role = detect_role(ROOT)
    created = bootstrap_layout(ROOT, role)
    problems = validate_layout(ROOT, role)
    payload = {
        "status": "PASS" if not problems else "FAIL",
        "phase": PHASE,
        "role": role.value,
        "created_or_verified": list(created),
        "problems": list(problems),
    }
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0 if not problems else 2


def cmd_doctor(args: argparse.Namespace) -> int:
    payload, code = _doctor_payload(args.profile)
    print(json.dumps(payload, indent=2, sort_keys=True))
    return code


def cmd_status(_: argparse.Namespace) -> int:
    role = detect_role(ROOT)
    problems = validate_layout(ROOT, role)
    payload = {
        "phase": PHASE,
        "active_execution_phase": ACTIVE_EXECUTION_PHASE if role.value == "EXECUTION" else PHASE,
        "phase_status": PHASE_STATUS,
        "phase_gate_status": PHASE_GATE_STATUS,
        "next_phase": NEXT_PHASE,
        "deferred_acceptance": list(DEFERRED_ACCEPTANCE),
        "role": role.value,
        "git": _git_identity(),
        "layout": "READY" if not problems else "NOT_BOOTSTRAPPED",
        "layout_problems": list(problems),
    }
    if role.value == "EXECUTION":
        payload["runtime"] = _active_runtimes(clean_stale=False)
        payload["execution_profiles"] = {
            name: _execution_state_summary(name) for name in PROFILES
        }
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


def cmd_arm(args: argparse.Namespace) -> int:
    role = detect_role(ROOT)
    if role.value != "EXECUTION":
        raise SystemExit("NBOT_ARM_EXECUTION_ROLE_ONLY")
    profile = get_profile(args.profile)
    if not profile.requires_arm_gate:
        raise SystemExit("NBOT_PROFILE_DOES_NOT_REQUIRE_ARMING")
    if profile.name == "live-trade":
        raise SystemExit("NBOT_LIVE_TRADE_ARMING_FORBIDDEN_BEFORE_V3_10")
    path = arm_path(ROOT, profile)
    identity = _git_identity()
    atomic_write_text(
        path,
        f"profile={profile.name}\nsha={identity['sha']}\narmed_at={utc_iso()}\n",
        mode=0o600,
    )
    if profile.name == "testnet-trade":
        from nbot.exchange.binance_testnet import initialize_testnet_guard_for_arm

        try:
            initialize_testnet_guard_for_arm(ROOT)
        except Exception:
            path.unlink(missing_ok=True)
            raise
    print(f"ARMED {profile.name} {path}")
    return 0


def cmd_disarm(args: argparse.Namespace) -> int:
    role = detect_role(ROOT)
    if role.value != "EXECUTION":
        raise SystemExit("NBOT_DISARM_EXECUTION_ROLE_ONLY")
    profile = get_profile(args.profile)
    if not profile.requires_arm_gate:
        raise SystemExit("NBOT_PROFILE_DOES_NOT_REQUIRE_ARMING")
    path = arm_path(ROOT, profile)
    path.unlink(missing_ok=True)
    print(f"DISARMED {profile.name}")
    return 0


def _start_execution(profile_name: str) -> int:
    active = _active_runtimes(clean_stale=True)
    if active:
        if len(active) == 1 and active[0]["profile"] == profile_name:
            print(json.dumps({"status": "ALREADY_RUNNING", **active[0]}, indent=2, sort_keys=True))
            return 0
        raise ValueError("NBOT_EXECUTION_RUNTIME_ALREADY_ACTIVE")

    doctor, doctor_code = _doctor_payload(profile_name)
    if doctor_code != 0:
        print(json.dumps(doctor, indent=2, sort_keys=True))
        return 2

    python = ROOT / ".venv/bin/python"
    preflight = subprocess.run(
        [str(python), str(ROOT / "run_execution.py"), "--profile", profile_name, "--preflight-only"],
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=False,
        timeout=30,
    )
    if preflight.returncode != 0:
        if preflight.stdout:
            print(preflight.stdout, end="")
        if preflight.stderr:
            print(preflight.stderr, file=sys.stderr, end="")
        return 2

    pid_path, ready_path, log_path = _runtime_paths(profile_name)
    runtime_stdout = execution_log_paths(ROOT, profile_name)["runtime"]
    pid_path.parent.mkdir(parents=True, exist_ok=True)
    log_path.parent.mkdir(parents=True, exist_ok=True)
    runtime_stdout.parent.mkdir(parents=True, exist_ok=True)
    ready_path.unlink(missing_ok=True)
    log_handle = runtime_stdout.open("a", encoding="utf-8")
    try:
        process = subprocess.Popen(
            [str(python), str(ROOT / "run_execution.py"), "--profile", profile_name],
            cwd=ROOT,
            stdout=log_handle,
            stderr=subprocess.STDOUT,
            start_new_session=True,
            close_fds=True,
        )
    finally:
        log_handle.close()

    identity = _git_identity()
    atomic_write_text(
        pid_path,
        f"profile={profile_name}\npid={process.pid}\nsha={identity['sha']}\nstarted_at={utc_iso()}\n",
        mode=0o600,
    )
    deadline = time.monotonic() + 20.0
    while time.monotonic() < deadline:
        if process.poll() is not None:
            pid_path.unlink(missing_ok=True)
            ready_path.unlink(missing_ok=True)
            print(f"FAIL NBOT_EXECUTION_PROCESS_EXITED:{process.returncode}", file=sys.stderr)
            return 2
        if ready_path.is_file():
            row = _runtime_record(profile_name) or {}
            print(json.dumps({"status": "STARTED", **row}, indent=2, sort_keys=True))
            return 0
        time.sleep(0.1)

    try:
        os.kill(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    pid_path.unlink(missing_ok=True)
    ready_path.unlink(missing_ok=True)
    print("FAIL NBOT_EXECUTION_START_READY_TIMEOUT", file=sys.stderr)
    return 2


def _systemd_execution_unit(profile_name: str) -> str | None:
    return {
        "live-paper": "nbot-execution-live-paper.service",
    }.get(profile_name)


def _systemd_unit_installed(unit: str | None) -> bool:
    if not unit:
        return False
    result = subprocess.run(
        ["systemctl", "show", "-p", "LoadState", "--value", unit],
        cwd=ROOT,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    return result.returncode == 0 and result.stdout.strip() == "loaded"


def _systemd_unit_active(unit: str | None) -> bool:
    if not unit:
        return False
    return subprocess.run(
        ["systemctl", "is-active", "--quiet", unit],
        cwd=ROOT,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode == 0


def _guard_manual_execution_lifecycle(profile_name: str, *, action: str) -> None:
    unit = _systemd_execution_unit(profile_name)
    if not _systemd_unit_installed(unit):
        return
    state = "ACTIVE" if _systemd_unit_active(unit) else "INSTALLED"
    raise ValueError(
        f"NBOT_EXECUTION_SYSTEMD_MANAGED:{profile_name}:{state}:"
        f"USE_SYSTEMCTL_{action.upper()}:{unit}"
    )


def cmd_start(args: argparse.Namespace) -> int:
    role = detect_role(ROOT)
    if role.value != "EXECUTION":
        raise ValueError("NBOT_START_EXECUTION_ROLE_ONLY_BEFORE_V3_3")
    profile = get_profile(args.profile)
    if profile.name == "live-trade":
        raise ValueError("NBOT_LIVE_TRADE_RUNTIME_FORBIDDEN_BEFORE_V3_10")
    _guard_manual_execution_lifecycle(profile.name, action="start")
    return _start_execution(profile.name)


def cmd_stop(_: argparse.Namespace) -> int:
    role = detect_role(ROOT)
    if role.value != "EXECUTION":
        raise ValueError("NBOT_STOP_EXECUTION_ROLE_ONLY_BEFORE_V3_3")
    active = _active_runtimes(clean_stale=True)
    if not active:
        print("NOT_RUNNING")
        return 0
    if len(active) != 1:
        raise ValueError("NBOT_MULTIPLE_EXECUTION_RUNTIMES_DETECTED")
    row = active[0]
    _guard_manual_execution_lifecycle(str(row["profile"]), action="stop")
    pid = int(row["pid"])
    pid_path, ready_path, _ = _runtime_paths(row["profile"])
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pid_path.unlink(missing_ok=True)
        ready_path.unlink(missing_ok=True)
        print("STOPPED_STALE_RUNTIME")
        return 0
    deadline = time.monotonic() + 10.0
    while time.monotonic() < deadline:
        if not _pid_matches_execution_runtime(pid, row["profile"]):
            pid_path.unlink(missing_ok=True)
            ready_path.unlink(missing_ok=True)
            print(f"STOPPED {row['profile']} pid={pid}")
            return 0
        time.sleep(0.1)
    print(f"FAIL NBOT_EXECUTION_STOP_TIMEOUT pid={pid}", file=sys.stderr)
    return 2


def cmd_restart(args: argparse.Namespace) -> int:
    code = cmd_stop(argparse.Namespace())
    if code != 0:
        return code
    return cmd_start(args)


def cmd_logs(args: argparse.Namespace) -> int:
    role = detect_role(ROOT)
    component = args.component
    if role.value == "OBSERVATION":
        paths = observation_log_paths(ROOT)
        component = component or "collector"
        if component not in paths:
            raise ValueError("NBOT_OBSERVATION_LOG_COMPONENT_INVALID")
        log_path = paths[component]
    else:
        profile_name = args.profile
        if profile_name is None:
            active = _active_runtimes(clean_stale=False)
            if len(active) == 1:
                profile_name = active[0]["profile"]
            else:
                raise ValueError("NBOT_LOG_PROFILE_REQUIRED_WITHOUT_SINGLE_ACTIVE_RUNTIME")
        paths = execution_log_paths(ROOT, profile_name)
        component = component or "execution"
        if component not in paths:
            raise ValueError("NBOT_EXECUTION_LOG_COMPONENT_INVALID")
        log_path = paths[component]
    if not log_path.is_file():
        raise ValueError(f"NBOT_LOG_MISSING:{log_path.relative_to(ROOT)}")
    if args.follow:
        return subprocess.call(["tail", "-n", str(args.lines), "-f", str(log_path)])
    rows = log_path.read_text(encoding="utf-8", errors="replace").splitlines()
    for line in rows[-args.lines:]:
        print(line)
    return 0


def _operator_profile(args: argparse.Namespace) -> str:
    profile = str(getattr(args, "profile", "") or "").strip()
    if profile:
        return profile
    active = _active_runtimes(clean_stale=False)
    if len(active) == 1:
        return str(active[0]["profile"])
    raise ValueError("NBOT_OPERATOR_PROFILE_REQUIRED")


def cmd_position(args: argparse.Namespace) -> int:
    profile = _operator_profile(args)
    payload = _execution_state_summary(profile)
    print(json.dumps({"profile": profile, "position": payload.get("open_position_detail")}, indent=2, sort_keys=True))
    return 0


def cmd_health(args: argparse.Namespace) -> int:
    profile = _operator_profile(args)
    payload = _execution_state_summary(profile)
    print(json.dumps({"profile": profile, "health": payload.get("health"), "recovery": payload.get("recovery")}, indent=2, sort_keys=True))
    return 0


def cmd_recent(args: argparse.Namespace) -> int:
    from nbot.execution.outcomes import ExecutionHistoryStore
    from nbot.execution.state import ExecutionStatePaths
    profile = _operator_profile(args)
    path = ExecutionStatePaths.for_profile(ROOT, profile).history_file
    rows = [] if not path.is_file() else ExecutionHistoryStore(path).records()
    print(json.dumps({"profile": profile, "recent": None if not rows else rows[-1]["payload"]}, indent=2, sort_keys=True))
    return 0


def cmd_pnl(args: argparse.Namespace) -> int:
    profile = _operator_profile(args)
    payload = _execution_state_summary(profile)
    state = payload.get("state")
    if state != "VALID":
        print(json.dumps({"profile": profile, "state": state, "daily_risk": None}, indent=2, sort_keys=True))
        return 0
    from nbot.execution.state import ExecutionStatePaths, ExecutionStateStore
    prof = get_profile(profile)
    paths = ExecutionStatePaths.for_profile(ROOT, profile)
    store = ExecutionStateStore(paths.state_file, profile=profile, market_environment=prof.market_environment)
    print(json.dumps({"profile": profile, "daily_risk": asdict(store.daily_risk)}, indent=2, sort_keys=True))
    return 0


def cmd_entries(args: argparse.Namespace) -> int:
    if detect_role(ROOT).value != "EXECUTION":
        raise ValueError("NBOT_ENTRIES_EXECUTION_ROLE_ONLY")
    profile = get_profile(args.profile)
    from nbot.operator.execution import set_operator_entry_block
    if args.action == "disable":
        set_operator_entry_block(ROOT, profile.name, blocked=True)
        print(f"OPERATOR_ENTRIES_DISABLED {profile.name}")
        return 0
    if profile.name == "live-paper":
        raise ValueError("NBOT_LIVE_PAPER_ENABLE_USE_RUNNING_TELEGRAM_OPERATOR_GATE")
    if profile.name == "testnet-trade" and not profile_is_armed(ROOT, profile):
        raise ValueError("NBOT_TESTNET_ENABLE_REQUIRES_ARM")
    if profile.name == "live-trade":
        raise ValueError("NBOT_LIVE_TRADE_RUNTIME_FORBIDDEN_BEFORE_V3_10")
    set_operator_entry_block(ROOT, profile.name, blocked=False)
    print(f"OPERATOR_ENTRIES_ENABLED_REQUEST {profile.name}")
    return 0


def cmd_not_implemented(args: argparse.Namespace) -> int:
    raise SystemExit(f"NBOT_V3_COMMAND_DEFERRED_TO_LATER_PHASE:{args.command}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="nbotctl")
    sub = parser.add_subparsers(dest="command", required=True)

    bootstrap = sub.add_parser("bootstrap")
    bootstrap.set_defaults(func=cmd_bootstrap)

    doctor = sub.add_parser("doctor")
    doctor.add_argument("profile", choices=sorted(PROFILES))
    doctor.set_defaults(func=cmd_doctor)

    status = sub.add_parser("status")
    status.set_defaults(func=cmd_status)

    for name in ("arm", "disarm"):
        p = sub.add_parser(name)
        p.add_argument("profile", choices=("testnet-trade", "live-trade"))
        p.set_defaults(func=cmd_arm if name == "arm" else cmd_disarm)

    start = sub.add_parser("start")
    start.add_argument("profile", choices=sorted(PROFILES))
    start.set_defaults(func=cmd_start)

    stop = sub.add_parser("stop")
    stop.set_defaults(func=cmd_stop)

    restart = sub.add_parser("restart")
    restart.add_argument("profile", choices=sorted(PROFILES))
    restart.set_defaults(func=cmd_restart)

    logs = sub.add_parser("logs")
    logs.add_argument("profile", nargs="?", choices=sorted(PROFILES))
    logs.add_argument("--component", choices=("execution", "trades", "runtime", "collector", "control", "research"))
    logs.add_argument("--lines", type=int, default=100)
    logs.add_argument("--follow", action="store_true")
    logs.set_defaults(func=cmd_logs)

    for name, func in (("position", cmd_position), ("health", cmd_health), ("recent", cmd_recent), ("pnl", cmd_pnl)):
        item = sub.add_parser(name)
        item.add_argument("profile", nargs="?", choices=sorted(PROFILES))
        item.set_defaults(func=func)

    entries = sub.add_parser("entries")
    entries.add_argument("action", choices=("enable", "disable"))
    entries.add_argument("profile", choices=sorted(PROFILES))
    entries.set_defaults(func=cmd_entries)

    cluster = sub.add_parser("cluster")
    cluster.add_argument("action", choices=("doctor", "start", "stop", "status"))
    cluster.add_argument("profile", nargs="?", choices=sorted(PROFILES))
    cluster.set_defaults(func=cmd_not_implemented)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    if hasattr(args, "lines") and args.lines <= 0:
        print("FAIL NBOT_LOG_LINES_INVALID", file=sys.stderr)
        return 2
    try:
        return int(args.func(args))
    except ValueError as exc:
        print(f"FAIL {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
